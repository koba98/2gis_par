# Подключение к PostgreSQL
PG_DSN=postgresql://postgres:password@localhost:5432/postgres
PG_SCHEMA=twogis

# Необязательно: прокси браузера (http://user:pass@host:port), множитель антибан-пауз
# (1.0 — по умолчанию, 1.5 — осторожнее), сколько секунд ждать ручного решения капчи
# (на сервере без человека — 0: этап сразу откладывается и повторяется позже)
DGIS_PROXY=
DGIS_PACE=1.0
DGIS_CAPTCHA_WAIT=120

# Для dgis_stations_parser.py (отдельный скрипт остановок)
PG_HOST=
PG_PORT=5432
PG_DB=
PG_USER=
PG_PASSWORD=
